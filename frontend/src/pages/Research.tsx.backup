import React, { useEffect, useState } from 'react';
import { fetchApi } from '../lib/api';
import { Cpu, BookOpen, Download, Search, FileText, ExternalLink, Sparkles } from 'lucide-react';

export const Research: React.FC = () => {
  const [projects, setProjects] = useState<any[]>([]);
  const [publications, setPublications] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadData() {
      try {
        const [projRes, pubRes] = await Promise.all([
          fetchApi<{ projects: any[] }>('/research/projects'),
          fetchApi<{ publications: any[] }>('/research/publications'),
        ]);
        setProjects(projRes.projects || []);
        setPublications(pubRes.publications || []);
      } catch (err) {
        console.error(err);
      } finally {
        setLoading(false);
      }
    }
    loadData();
  }, []);

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
      <div className="text-center space-y-4 max-w-3xl mx-auto">
        <h1 className="text-xs font-mono font-bold uppercase tracking-widest text-purple-400">Research Institute</h1>
        <h2 className="text-3xl sm:text-5xl font-black text-white">Peer-Reviewed Science & AI Discovery</h2>
        <p className="text-slate-300 text-sm sm:text-base">
          Investigating neuro-symbolic reasoning, formal verification, post-quantum cryptography, and edge intelligence.
        </p>
      </div>

      {/* Active Research Projects */}
      <div className="space-y-6">
        <h3 className="text-2xl font-bold text-white flex items-center gap-2">
          <Cpu className="w-6 h-6 text-brand-400" />
          <span>Active Research Initiatives</span>
        </h3>

        {loading ? (
          <p className="text-slate-400 text-sm font-mono animate-pulse">Loading CADELIBORA Research Index...</p>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
            {projects.map((proj) => (
              <div key={proj.id} className="p-8 rounded-3xl glass-panel border border-slate-800 space-y-4">
                <div className="flex items-center justify-between">
                  <span className="px-3 py-1 bg-brand-500/10 border border-brand-500/30 text-brand-400 text-xs font-mono rounded-full font-bold">
                    {proj.area}
                  </span>
                  <span className="text-xs font-mono text-emerald-400 font-semibold">{proj.status}</span>
                </div>
                <h4 className="text-xl font-bold text-white">{proj.title}</h4>
                <p className="text-sm text-slate-300 leading-relaxed">{proj.description}</p>

                <div className="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono">
                  <span>Lead: {proj.leadResearcher?.fullName}</span>
                  <span>Timeline: {proj.startYear} - {proj.endYear || 'Present'}</span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      {/* Publications */}
      <div className="space-y-6 pt-8">
        <h3 className="text-2xl font-bold text-white flex items-center gap-2">
          <BookOpen className="w-6 h-6 text-purple-400" />
          <span>Peer-Reviewed Publications & Papers</span>
        </h3>

        <div className="space-y-4">
          {publications.map((pub) => (
            <div key={pub.id} className="p-6 rounded-2xl glass-panel border border-slate-800 space-y-2">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <h4 className="text-lg font-bold text-white hover:text-brand-400 cursor-pointer">{pub.title}</h4>
                <span className="text-xs font-mono text-slate-400 px-2 py-1 bg-slate-900 rounded border border-slate-800">
                  {pub.journal} ({pub.year})
                </span>
              </div>
              <p className="text-xs text-slate-400 font-mono">Authors: {pub.authors}</p>
              <p className="text-sm text-slate-300 leading-relaxed pt-1">{pub.abstract}</p>
              {pub.doi && (
                <div className="pt-2 text-xs font-mono text-cyber-accent flex items-center gap-2">
                  <ExternalLink className="w-3.5 h-3.5" />
                  <span>DOI: {pub.doi}</span>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};
