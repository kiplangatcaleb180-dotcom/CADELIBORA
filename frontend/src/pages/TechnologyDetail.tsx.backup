import React, { useEffect, useState } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import {
  ArrowLeft,
  ArrowRight,
  BookOpen,
  ExternalLink,
  Layers,
  Loader2,
  Server,
  Tag,
  XCircle,
} from 'lucide-react';
import { ApiService } from '../services/apiService';

interface Technology {
  id: string;
  name: string;
  slug: string;
  category: string;
  description: string;
  icon?: string | null;
  websiteUrl?: string | null;
  docsUrl?: string | null;
  version?: string | null;
  featured: boolean;
  isPublished: boolean;
  sortOrder: number;
}

interface TechnologyDomain {
  id: string;
  name: string;
  slug: string;
  description: string;
  icon?: string | null;
  coverImage?: string | null;
  sortOrder: number;
  isPublished: boolean;
}

interface TechnologySection {
  id: string;
  sectionKey: string;
  title: string;
  content: string;
  imageUrl?: string | null;
  sortOrder: number;
  isPublished: boolean;
}

interface TechnologyDomainRelation {
  id: string;
  domainId: string;
  technologyId: string;
  sortOrder: number;
  domain: TechnologyDomain;
}

interface TechnologySectionRelation {
  id: string;
  sectionId: string;
  technologyId: string;
  sortOrder: number;
  section: TechnologySection;
}

interface TechnologyDetailResponse {
  success: boolean;
  technology: Technology & {
    domains: TechnologyDomainRelation[];
    sections: TechnologySectionRelation[];
  };
  relatedTechnologies: Technology[];
}

export const TechnologyDetail: React.FC = () => {
  const { slug } = useParams<{ slug: string }>();
  const navigate = useNavigate();

  const [technology, setTechnology] =
    useState<TechnologyDetailResponse['technology'] | null>(null);

  const [relatedTechnologies, setRelatedTechnologies] =
    useState<Technology[]>([]);

  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  useEffect(() => {
    const loadTechnology = async () => {
      if (!slug) {
        setError('Technology was not specified.');
        setLoading(false);
        return;
      }

      try {
        setLoading(true);
        setError('');

        const response =
          await ApiService.get<TechnologyDetailResponse>(
            `/technology/${encodeURIComponent(slug)}`
          );

        if (!response.success || !response.technology) {
          throw new Error('Technology not found.');
        }

        setTechnology(response.technology);
        setRelatedTechnologies(
          response.relatedTechnologies || []
        );

        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      } catch (err: any) {
        console.error(err);

        setTechnology(null);

        setError(
          err?.message ||
            'Unable to load this technology.'
        );
      } finally {
        setLoading(false);
      }
    };

    loadTechnology();
  }, [slug]);

  if (loading) {
    return (
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div className="flex min-h-[40vh] items-center justify-center">
          <div className="flex items-center gap-3 text-slate-400">
            <Loader2 className="h-5 w-5 animate-spin" />
            <span>Loading technology...</span>
          </div>
        </div>
      </div>
    );
  }

  if (error || !technology) {
    return (
      <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div className="rounded-3xl border border-slate-800 bg-slate-950 p-8 text-center shadow-xl">
          <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-red-500/10 text-red-400">
            <XCircle className="h-7 w-7" />
          </div>

          <h1 className="mt-5 text-2xl font-bold text-white">
            Technology not found
          </h1>

          <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-400">
            {error ||
              'The technology you are looking for could not be found.'}
          </p>

          <button
            type="button"
            onClick={() => navigate('/technology')}
            className="mt-6 inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-400"
          >
            <ArrowLeft className="h-4 w-4" />
            Back to Technology Center
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-950 text-white">
      <section className="relative overflow-hidden border-b border-slate-800">
        <div className="absolute inset-0 bg-gradient-to-br from-brand-500/10 via-transparent to-cyan-500/5" />

        <div className="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
          <Link
            to="/technology"
            className="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition hover:text-brand-400"
          >
            <ArrowLeft className="h-4 w-4" />
            Back to Technology Center
          </Link>

          <div className="mt-10 flex flex-col gap-8 lg:flex-row lg:items-center">
            <div className="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-xl">
              {technology.icon ? (
                <img
                  src={technology.icon}
                  alt={`${technology.name} icon`}
                  className="h-14 w-14 object-contain"
                  onError={(event) => {
                    event.currentTarget.style.display = 'none';
                  }}
                />
              ) : (
                <Server className="h-12 w-12 text-brand-400" />
              )}
            </div>

            <div className="max-w-4xl">
              <div className="flex flex-wrap items-center gap-2">
                <span className="rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-300">
                  {technology.category}
                </span>

                {technology.featured && (
                  <span className="rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-300">
                    Featured
                  </span>
                )}
              </div>

              <h1 className="mt-4 text-4xl font-black tracking-tight sm:text-5xl">
                {technology.name}
              </h1>

              <p className="mt-4 max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
                {technology.description}
              </p>
            </div>
          </div>
        </div>
      </section>

      <main className="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div className="grid gap-6 lg:grid-cols-3">
          <section className="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 lg:col-span-2">
            <div className="flex items-center gap-3">
              <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400">
                <BookOpen className="h-5 w-5" />
              </div>

              <div>
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Overview
                </p>
                <h2 className="text-xl font-bold text-white">
                  About {technology.name}
                </h2>
              </div>
            </div>

            <p className="mt-6 text-sm leading-8 text-slate-300">
              {technology.description}
            </p>
          </section>

          <aside className="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <div className="flex items-center gap-3">
              <Tag className="h-5 w-5 text-brand-400" />
              <h2 className="font-bold text-white">
                Technology Details
              </h2>
            </div>

            <dl className="mt-5 space-y-4">
              <div className="flex items-center justify-between gap-4">
                <dt className="text-sm text-slate-500">
                  Category
                </dt>
                <dd className="text-right text-sm font-medium text-slate-200">
                  {technology.category}
                </dd>
              </div>

              <div className="flex items-center justify-between gap-4">
                <dt className="text-sm text-slate-500">
                  Version
                </dt>
                <dd className="text-right text-sm font-medium text-slate-200">
                  {technology.version || 'Not specified'}
                </dd>
              </div>

              <div className="flex items-center justify-between gap-4">
                <dt className="text-sm text-slate-500">
                  Status
                </dt>
                <dd className="text-right text-sm font-medium text-emerald-400">
                  Published
                </dd>
              </div>
            </dl>
          </aside>
        </div>

        {technology.domains.length > 0 && (
          <section className="mt-8 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <div className="flex items-center gap-3">
              <Layers className="h-5 w-5 text-brand-400" />
              <div>
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Connected Domains
                </p>
                <h2 className="text-xl font-bold text-white">
                  Used In
                </h2>
              </div>
            </div>

            <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {technology.domains
                .slice()
                .sort(
                  (a, b) =>
                    a.sortOrder - b.sortOrder ||
                    a.domain.sortOrder - b.domain.sortOrder
                )
                .map((relation) => (
                  <button
                    key={relation.id}
                    type="button"
                    onClick={() =>
                      navigate('/technology')
                    }
                    className="group rounded-xl border border-slate-800 bg-slate-950 p-4 text-left transition hover:border-brand-500/40 hover:bg-slate-800"
                  >
                    <div className="flex items-center justify-between gap-3">
                      <span className="font-semibold text-slate-200 transition group-hover:text-brand-400">
                        {relation.domain.name}
                      </span>
                      <ArrowRight className="h-4 w-4 text-slate-600 transition group-hover:translate-x-1 group-hover:text-brand-400" />
                    </div>

                    <p className="mt-2 text-xs leading-5 text-slate-500">
                      {relation.domain.description}
                    </p>
                  </button>
                ))}
            </div>
          </section>
        )}

        {technology.sections.length > 0 && (
          <section className="mt-8">
            <div className="mb-5">
              <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                Technology Sections
              </p>
              <h2 className="mt-1 text-2xl font-bold text-white">
                Related Sections
              </h2>
            </div>

            <div className="grid gap-4 md:grid-cols-2">
              {technology.sections
                .slice()
                .sort(
                  (a, b) =>
                    a.sortOrder - b.sortOrder ||
                    a.section.sortOrder - b.section.sortOrder
                )
                .map((relation) => (
                  <button
                    key={relation.id}
                    type="button"
                    onClick={() =>
                      navigate('/technology')
                    }
                    className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 text-left transition hover:border-brand-500/40 hover:bg-slate-800/80"
                  >
                    <h3 className="font-bold text-white">
                      {relation.section.title.replace(
                        /-/g,
                        ' '
                      )}
                    </h3>

                    <p className="mt-2 text-sm leading-6 text-slate-400">
                      {relation.section.content}
                    </p>
                  </button>
                ))}
            </div>
          </section>
        )}

        {relatedTechnologies.length > 0 && (
          <section className="mt-10">
            <div className="mb-5 flex items-end justify-between gap-4">
              <div>
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Explore More
                </p>
                <h2 className="mt-1 text-2xl font-bold text-white">
                  Related Technologies
                </h2>
              </div>

              <Link
                to="/technology"
                className="hidden items-center gap-2 text-sm font-medium text-brand-400 transition hover:text-brand-300 sm:flex"
              >
                View all
                <ArrowRight className="h-4 w-4" />
              </Link>
            </div>

            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {relatedTechnologies.map((item) => (
                <Link
                  key={item.id}
                  to={`/technology/${item.slug}`}
                  className="group rounded-2xl border border-slate-800 bg-slate-900/60 p-5 transition hover:-translate-y-0.5 hover:border-brand-500/40 hover:bg-slate-800/80"
                >
                  <div className="flex items-center gap-4">
                    <div className="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
                      {item.icon ? (
                        <img
                          src={item.icon}
                          alt=""
                          className="h-8 w-8 object-contain"
                        />
                      ) : (
                        <Server className="h-6 w-6 text-brand-400" />
                      )}
                    </div>

                    <div className="min-w-0">
                      <h3 className="truncate font-bold text-white transition group-hover:text-brand-400">
                        {item.name}
                      </h3>
                      <p className="mt-1 text-xs text-slate-500">
                        {item.category}
                      </p>
                    </div>
                  </div>

                  <p className="mt-4 line-clamp-2 text-sm leading-6 text-slate-400">
                    {item.description}
                  </p>
                </Link>
              ))}
            </div>
          </section>
        )}

        {(technology.websiteUrl || technology.docsUrl) && (
          <section className="mt-10 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <div className="flex items-center gap-3">
              <ExternalLink className="h-5 w-5 text-brand-400" />
              <h2 className="text-xl font-bold text-white">
                Resources
              </h2>
            </div>

            <div className="mt-5 flex flex-wrap gap-3">
              {technology.websiteUrl && (
                <a
                  href={technology.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm font-semibold text-slate-200 transition hover:border-brand-500/40 hover:text-brand-400"
                >
                  Official Website
                  <ExternalLink className="h-4 w-4" />
                </a>
              )}

              {technology.docsUrl && (
                <a
                  href={technology.docsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-400"
                >
                  Documentation
                  <BookOpen className="h-4 w-4" />
                </a>
              )}
            </div>
          </section>
        )}
      </main>
    </div>
  );
};

export default TechnologyDetail;
