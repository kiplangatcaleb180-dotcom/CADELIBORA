                    <div className="mt-5 flex flex-wrap gap-2">
                      {assignedTechnologies.map((relation) => (
                        <button
                          key={relation.id}
                          type="button"
                          onClick={() =>
                            setSelectedTechnology(
                              relation.technology
                            )
                          }
                          className="inline-flex items-center gap-2 rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-200 transition hover:border-brand-500/40 hover:bg-slate-800 hover:text-white"
                        >
                          {relation.technology.icon ? (
                            <img
                              src={relation.technology.icon}
                              alt=""
                              className="h-5 w-5 object-contain"
                            />
                          ) : (
                            <Code className="h-4 w-4 text-brand-400" />
                          )}

                          {relation.technology.name}
                        </button>
                      ))}
                    </div>
                  )}

                  <div className="mt-5 flex items-center justify-between">
                    <span className="text-xs font-medium text-slate-500">
                      {assignedTechnologies.length > 0
                        ? `${assignedTechnologies.length} related technologies`
                        : 'No technologies assigned'}
                    </span>

                    <button
                      type="button"
                      onClick={() => {
                        setSelectedTechnology(null);
                        setSearchQuery('');
                        setSelectedCategory('all');
                        updateDomainFilter(null);
                        updateSectionFilter(section.id);

                        setTimeout(() => {
                          document
                            .getElementById('technology-catalog')
                            ?.scrollIntoView({
                              behavior: 'smooth',
                            });
                        }, 50);
                      }}
                      className="inline-flex items-center gap-2 text-xs font-semibold text-brand-400 transition hover:text-brand-300"
                    >
                      Explore
                      <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
                    </button>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {/* EMPTY STATE */}
      {technologies.length === 0 &&
        domains.length === 0 &&
        stack.length === 0 &&
        sections.length === 0 && (
          <section className="rounded-3xl border border-slate-800 bg-slate-900/40 p-12 text-center">
            <Cpu className="mx-auto w-10 h-10 text-slate-600" />

            <h2 className="mt-4 text-xl font-bold text-white">
              Technology content is coming soon
            </h2>

            <p className="mt-2 text-sm text-slate-400">
              The Technology Center does not have any published
              content yet.
            </p>
          </section>
        )}

      {selectedTechnology && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4 backdrop-blur-sm"
          onClick={() => setSelectedTechnology(null)}
        >
          <div
            className="relative w-full max-w-2xl rounded-2xl border border-slate-800 bg-slate-950 p-6 shadow-2xl"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Close button */}
            <button
              type="button"
              onClick={() => setSelectedTechnology(null)}
              className="absolute right-4 top-4 rounded-lg p-2 text-slate-400 transition hover:bg-slate-800 hover:text-white"
              aria-label="Close technology details"
            >
              <X className="h-5 w-5" />
            </button>

            {/* Technology header */}
            <div className="flex items-start gap-4 pr-10">
              <div className="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-slate-800 bg-slate-900">
                {selectedTechnology.icon ? (
                  <img
                    src={selectedTechnology.icon}
                    alt=""
                    className="h-10 w-10 object-contain"
                  />
                ) : (
                  <Code className="h-7 w-7 text-brand-400" />
                )}
              </div>

              <div>
                <div className="flex flex-wrap items-center gap-2">
                  <h2 className="text-2xl font-bold text-white">
                    {selectedTechnology.name}
                  </h2>

                  {selectedTechnology.featured && (
                    <span className="rounded-full bg-brand-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-brand-400">
                      Featured
                    </span>
                  )}
                </div>

                <p className="mt-1 text-sm font-medium text-brand-400">
                  {selectedTechnology.category}
                </p>
              </div>
            </div>

            {/* Description */}
            <div className="mt-6">
              <p className="text-sm leading-7 text-slate-300">
                {selectedTechnology.description}
              </p>
            </div>

            {/* Metadata */}
            <div className="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {selectedTechnology.version && (
                <div className="rounded-xl border border-slate-800 bg-slate-900/70 p-4">
                  <p className="text-xs uppercase tracking-wider text-slate-500">
                    Version
                  </p>
                  <p className="mt-1 text-sm font-semibold text-white">
                    {selectedTechnology.version}
                  </p>
                </div>
              )}

              <div className="rounded-xl border border-slate-800 bg-slate-900/70 p-4">
                <p className="text-xs uppercase tracking-wider text-slate-500">
                  Category
                </p>
                <p className="mt-1 text-sm font-semibold text-white">
                  {selectedTechnology.category}
                </p>
              </div>
            </div>

            {/* Related domains */}
            {domains.filter((domain) =>
              domain.technologies?.some(
                (relation) =>
                  relation.technologyId === selectedTechnology.id
              )
            ).length > 0 && (
              <div className="mt-6">
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Used In
                </p>

                <div className="mt-3 flex flex-wrap gap-2">
                  {domains
                    .filter((domain) =>
                      domain.technologies?.some(
                        (relation) =>
                          relation.technologyId ===
                          selectedTechnology.id
                      )
                    )
                    .map((domain) => (
  <button
    key={domain.id}
    type="button"
    onClick={() => {
      setSelectedTechnology(null);
      updateDomainFilter(domain.id);
      setSelectedCategory('all');
      setSearchQuery('');

      setTimeout(() => {
        document
          .getElementById('technology-catalog')
          ?.scrollIntoView({ behavior: 'smooth' });
      }, 50);
    }}
    className="rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 transition hover:border-brand-500/40 hover:bg-slate-800 hover:text-brand-400"
  >
    {domain.name}
  </button>
))
                    }
                </div>

                <button
                  type="button"
                  onClick={() => {
                    setSelectedCategory('all');
                    setSearchQuery('');
                    setShowFeaturedOnly(false);
                    setSelectedDomain(null);
                    setSelectedSection(null);
                    setSearchParams({}, { replace: true });
                  }}
                  className="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-slate-600 hover:bg-slate-800 hover:text-white"
                >
                  <X className="h-3.5 w-3.5" />
                  Clear Filters
                </button>
              </div>
            )}

            {/* RELATED SECTIONS */}
            {sections.filter((section) =>
              section.technologies?.some(
                (relation) =>
                  relation.technologyId === selectedTechnology.id
              )
            ).length > 0 && (
              <div className="mt-6">
                <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Related Sections
                </p>

                <div className="mt-3 flex flex-wrap gap-2">
                  {sections
                    .filter((section) =>
                      section.technologies?.some(
                        (relation) =>
                          relation.technologyId ===
                          selectedTechnology.id
                      )
                    )
                    .sort(
                      (a, b) =>
                        a.sortOrder - b.sortOrder ||
                        a.title.localeCompare(b.title)
                    )
                    .map((section) => (
                      <button
                        key={section.id}
                        type="button"
                        onClick={() => {
                          setSelectedTechnology(null);
                          updateSectionFilter(section.id);
                          updateDomainFilter(null);
                          setSelectedCategory('all');
                          setSearchQuery('');

                          setTimeout(() => {
                            document
                              .getElementById('technology-catalog')
                              ?.scrollIntoView({
                                behavior: 'smooth',
                              });
                          }, 50);
                        }}
                        className="rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300 transition hover:border-brand-500/40 hover:bg-slate-800 hover:text-brand-400"
                      >
                        {section.title}
                      </button>
                    ))}
                </div>
              </div>
            )}

            {/* RELATED TECHNOLOGIES */}
{technologies.filter(
  (technology) =>
    technology.id !== selectedTechnology.id &&
    technology.category.toLowerCase() ===
      selectedTechnology.category.toLowerCase()
).length > 0 && (
  <div className="mt-6">
    <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">
      Related Technologies
    </p>

    <div className="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {technologies
        .filter(
          (technology) =>
            technology.id !== selectedTechnology.id &&
            technology.category.toLowerCase() ===
              selectedTechnology.category.toLowerCase()
        )
        .slice(0, 4)
        .map((technology) => (
          <button
            key={technology.id}
            type="button"
            onClick={() => navigate(`/technology/${technology.slug}`)}
            className="group flex items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/70 p-3 text-left transition hover:border-brand-500/40 hover:bg-slate-800"
          >
            <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-800 bg-slate-950">
              {technology.icon ? (
                <img
                  src={technology.icon}
                  alt=""
                  className="h-6 w-6 object-contain"
                />
              ) : (
                <Code className="h-4 w-4 text-brand-400" />
              )}
            </div>

            <div className="min-w-0">
              <p className="truncate text-sm font-semibold text-white">
                {technology.name}
              </p>

              <p className="mt-0.5 text-xs text-slate-500">
                {technology.category}
              </p>
            </div>

            <ArrowRight className="ml-auto h-4 w-4 shrink-0 text-slate-600 transition group-hover:text-brand-400" />
          </button>
        ))}
    </div>
  </div>
)}

            {/* External links */}
            {(selectedTechnology.websiteUrl ||
              selectedTechnology.docsUrl) && (
              <div className="mt-6 flex flex-wrap gap-3">
                {selectedTechnology.websiteUrl && (
                  <a
                    href={selectedTechnology.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-200 transition hover:border-brand-500/40 hover:text-brand-400"
                  >
                    Official Website
                    <ExternalLink className="h-4 w-4" />
                  </a>
                )}

                {selectedTechnology.docsUrl && (
                  <a
                    href={selectedTechnology.docsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-4 py-2.5 text-sm font-medium text-slate-200 transition hover:border-brand-500/40 hover:text-brand-400"
                  >
                    Documentation
                    <ExternalLink className="h-4 w-4" />
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      )}
        
    </div>
    
  );
};

export default Technology;

