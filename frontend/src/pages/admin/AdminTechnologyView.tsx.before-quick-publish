              ? 'Domain'
              : activeTab === 'technologies'
                ? 'Technology'
                : activeTab === 'stack'
                  ? 'Stack Item'
                  : 'Section'}
          </button>
        </div>

        <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <p className="text-xs uppercase tracking-wide text-slate-500">Domains</p>
            <p className="mt-2 text-2xl font-bold">{domains.length}</p>
            <p className="mt-1 text-xs text-emerald-400">{publishedDomains} published</p>
          </div>

          <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <p className="text-xs uppercase tracking-wide text-slate-500">Technologies</p>
            <p className="mt-2 text-2xl font-bold">{technologies.length}</p>
            <p className="mt-1 text-xs text-emerald-400">{publishedTechnologies} published</p>
          </div>

          <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <p className="text-xs uppercase tracking-wide text-slate-500">Stack Items</p>
            <p className="mt-2 text-2xl font-bold">{stack.length}</p>
            <p className="mt-1 text-xs text-slate-500">Technology stack</p>
          </div>

          <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
            <p className="text-xs uppercase tracking-wide text-slate-500">Sections</p>
            <p className="mt-2 text-2xl font-bold">{sections.length}</p>
            <p className="mt-1 text-xs text-emerald-400">{publishedSections} published</p>
          </div>
        </div>

        <div className="rounded-2xl border border-slate-800 bg-slate-900/60 p-4">
          <div className="relative">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" />

            <input
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder={`Search ${activeTab}...`}
              className={`${inputClass} pl-10 pr-10`}
            />

            {searchQuery && (
              <button
                type="button"
                onClick={() => setSearchQuery('')}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-200"
              >
                <X className="h-4 w-4" />
              </button>
            )}
          </div>

          {normalizedSearch && (
            <p className="mt-3 text-xs text-slate-500">
              Showing filtered results for "{searchQuery}"
            </p>
          )}
        </div>

        {error && (
          <div className="rounded-xl border border-red-500/20 bg-red-500/10 p-4 text-sm text-red-300">
            {error}
          </div>
        )}

        {success && (
          <div className="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm text-emerald-300">
            {success}
          </div>
        )}

        <div className="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60">
          <div className="flex min-w-max">
            {tabItems.map((tab) => {
              const Icon = tab.icon;
              const active = activeTab === tab.id;

              return (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 border-b-2 px-5 py-4 text-sm font-semibold ${
                    active
                      ? 'border-brand-500 text-brand-400'
                      : 'border-transparent text-slate-500 hover:text-slate-200'
                  }`}
                >
                  <Icon className="h-4 w-4" />
                  {tab.label}
                  <span className="rounded-full bg-slate-800 px-2 py-0.5 text-[10px]">
                    {tab.count}
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        <div className="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60">
          {loading ? (
            <div className="flex min-h-72 items-center justify-center text-sm text-slate-500">
              Loading technology data...
            </div>
          ) : (
            renderTable()
          )}
        </div>
      </div>

      {formOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm">
          <div className="flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-2xl">

            <div className="flex items-center justify-between border-b border-slate-800 px-6 py-5">
              <div>
                <h2 className="text-lg font-bold">
                  {formMode === 'create' ? 'Create' : 'Edit'}{' '}
                  {activeTab === 'domains'
                    ? 'Technology Domain'
                    : activeTab === 'technologies'
                      ? 'Technology'
                      : activeTab === 'stack'
                        ? 'Technology Stack Item'
                        : 'Technology Section'}
                </h2>
              </div>

              <button
                type="button"
                onClick={() => setFormOpen(false)}
                className="rounded-lg p-2 text-slate-500 hover:bg-slate-800 hover:text-slate-200"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <div className="overflow-y-auto px-6 py-6">
              {activeTab === 'domains' && renderDomainForm()}
              {activeTab === 'technologies' && renderTechnologyForm()}
              {activeTab === 'stack' && renderStackForm()}
              {activeTab === 'sections' && renderSectionForm()}
            </div>

            <div className="flex justify-end gap-3 border-t border-slate-800 px-6 py-4">
              <button
                type="button"
                onClick={() => setFormOpen(false)}
                disabled={saving}
                className={`${buttonClass} border border-slate-700 bg-slate-800 text-slate-300`}
              >
                <X className="h-4 w-4" />
                Cancel
              </button>

              <button
                type="button"
                onClick={handleSave}
                disabled={saving}
                className={`${buttonClass} bg-brand-600 text-white disabled:opacity-50`}
              >
                {saving ? (
                  'Saving...'
                ) : (
                  <>
                    <Save className="h-4 w-4" />
                    Save Changes
                  </>
                )}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );

};

