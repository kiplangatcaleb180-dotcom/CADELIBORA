import {
  DndContext,
  closestCenter,
  type DragEndEvent,
} from '@dnd-kit/core';

import {
  SortableContext,
  useSortable,
  verticalListSortingStrategy,
  arrayMove,
} from '@dnd-kit/sortable';

import { CSS } from '@dnd-kit/utilities';

import React, { useEffect, useState } from 'react';
import {
  Plus,
  Pencil,
  Trash2,
  Save,
  X,
  Cpu,
  Layers,
  Code2,
  FileText,
  CheckCircle2,
  XCircle,
  Search,
  Globe2,
  Database,
} from 'lucide-react';
import { ApiService } from '../../services/apiService';

type Tab = 'domains' | 'technologies' | 'stack' | 'sections';

interface TechnologyDomain {
  id: string;
  name: string;
  slug: string;
  description: string;
  icon?: string | null;
  coverImage?: string | null;
  technologies?: Array<{
    id: string;
    domainId: string;
    technologyId: string;
    sortOrder: number;
    technology: Technology;
  }>;
  sortOrder: number;
  isPublished: boolean;
}

interface Technology {
  id: string;
  name: string;
  slug: string;
  category: string;
  description: string;
  icon?: string | null;
  websiteUrl?: string | null;
  docsUrl?: string | null;
  version?: string | null;
  featured: boolean;
  isPublished: boolean;
  sortOrder: number;
}

interface TechnologyStack {
  id: string;
  name: string;
  type: string;
  description?: string | null;
  icon?: string | null;
  websiteUrl?: string | null;
  sortOrder: number;
  isPublished: boolean;
}

interface TechnologySection {
  id: string;
  sectionKey: string;
  title: string;
  content: string;
  imageUrl?: string | null;
  sortOrder: number;
  isPublished: boolean;
  technologies?: Array<{
    id: string;
    sectionId: string;
    technologyId: string;
    sortOrder: number;
    technology: Technology;
  }>;
}

type FormMode = 'create' | 'edit';

const emptyDomain = {
  name: '',
  slug: '',
  description: '',
  icon: '',
  coverImage: '',
  technologyIds: [] as string[],
  sortOrder: 0,
  isPublished: true,
};

const emptyTechnology = {
  name: '',
  slug: '',
  category: '',
  description: '',
  icon: '',
  websiteUrl: '',
  docsUrl: '',
  version: '',
  featured: false,
  isPublished: true,
  sortOrder: 0,
};

const emptyStack = {
  name: '',
  type: '',
  description: '',
  icon: '',
  websiteUrl: '',
  sortOrder: 0,
  isPublished: true,
};

const emptySection = {
  sectionKey: '',
  title: '',
  content: '',
  imageUrl: '',
  technologyIds: [] as string[],
  sortOrder: 0,
  isPublished: true,
};

export const AdminTechnologyView: React.FC = () => {
  const [activeTab, setActiveTab] = useState<Tab>('domains');
  const [searchQuery, setSearchQuery] = useState('');

  const [domains, setDomains] = useState<TechnologyDomain[]>([]);
  const [technologies, setTechnologies] = useState<Technology[]>([]);
  const [stack, setStack] = useState<TechnologyStack[]>([]);
  const [sections, setSections] = useState<TechnologySection[]>([]);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  const [formOpen, setFormOpen] = useState(false);
  const [formMode, setFormMode] = useState<FormMode>('create');

  const [editingId, setEditingId] = useState<string | null>(null);

  const [domainForm, setDomainForm] = useState(emptyDomain);
  const [technologyForm, setTechnologyForm] =
    useState(emptyTechnology);
  const [stackForm, setStackForm] = useState(emptyStack);
  const [sectionForm, setSectionForm] = useState(emptySection);

  const showSuccess = (message: string) => {
    setSuccess(message);
    setError('');

    window.setTimeout(() => {
      setSuccess('');
    }, 3000);
  };

  const showError = (message: string) => {
    setError(message);
    setSuccess('');
  };

  const loadAll = async () => {
    try {
      setLoading(true);
      setError('');

      const [
        domainsResponse,
        technologiesResponse,
        stackResponse,
        sectionsResponse,
      ] = await Promise.all([
        ApiService.get<{
          success: boolean;
          domains: TechnologyDomain[];
        }>('/admin/technology/domains'),

        ApiService.get<{
          success: boolean;
          technologies: Technology[];
        }>('/admin/technology/technologies'),

        ApiService.get<{
          success: boolean;
          stack: TechnologyStack[];
        }>('/admin/technology/stack'),

        ApiService.get<{
          success: boolean;
          sections: TechnologySection[];
        }>('/admin/technology/sections'),
      ]);

      if (domainsResponse.success) {
        setDomains(domainsResponse.domains);
      }

      if (technologiesResponse.success) {
        setTechnologies(technologiesResponse.technologies);
      }

      if (stackResponse.success) {
        setStack(stackResponse.stack);
      }

      if (sectionsResponse.success) {
        setSections(sectionsResponse.sections);
      }
    } catch (err: any) {
      console.error(err);

      showError(
        err?.message ||
          'Failed to load Technology administration data.'
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    loadAll();
  }, []);

  const resetForm = () => {
    setDomainForm(emptyDomain);
    setTechnologyForm(emptyTechnology);
    setStackForm(emptyStack);
    setSectionForm(emptySection);

    setEditingId(null);
    setFormMode('create');
    setFormOpen(false);
  };

  const openCreate = () => {
    setEditingId(null);
    setFormMode('create');

    setDomainForm(emptyDomain);
    setTechnologyForm(emptyTechnology);
    setStackForm(emptyStack);
    setSectionForm(emptySection);

    setFormOpen(true);
    setError('');
  };

  const openEditDomain = (domain: TechnologyDomain) => {
    setActiveTab('domains');
    setFormMode('edit');
    setEditingId(domain.id);

    setDomainForm({
  name: domain.name,
  slug: domain.slug,
  description: domain.description,
  icon: domain.icon || '',
  coverImage: domain.coverImage || '',
  technologyIds:
    domain.technologies?.map(
      (item) => item.technologyId
    ) || [],
  sortOrder: domain.sortOrder,
  isPublished: domain.isPublished,
});

    setFormOpen(true);
  };

  const openEditTechnology = (technology: Technology) => {
    setActiveTab('technologies');
    setFormMode('edit');
    setEditingId(technology.id);

    setTechnologyForm({
      name: technology.name,
      slug: technology.slug,
      category: technology.category,
      description: technology.description,
      icon: technology.icon || '',
      websiteUrl: technology.websiteUrl || '',
      docsUrl: technology.docsUrl || '',
      version: technology.version || '',
      featured: technology.featured,
      isPublished: technology.isPublished,
      sortOrder: technology.sortOrder,
    });

    setFormOpen(true);
  };

  const openEditStack = (item: TechnologyStack) => {
    setActiveTab('stack');
    setFormMode('edit');
    setEditingId(item.id);

    setStackForm({
      name: item.name,
      type: item.type,
      description: item.description || '',
      icon: item.icon || '',
      websiteUrl: item.websiteUrl || '',
      sortOrder: item.sortOrder,
      isPublished: item.isPublished,
    });

    setFormOpen(true);
  };

  const openEditSection = (section: TechnologySection) => {
    setActiveTab('sections');
    setFormMode('edit');
    setEditingId(section.id);

    setSectionForm({
      sectionKey: section.sectionKey,
      title: section.title,
      content: section.content,
      imageUrl: section.imageUrl || '',
      technologyIds:
        section.technologies?.map(
          (item) => item.technologyId
        ) || [],
      sortOrder: section.sortOrder,
      isPublished: section.isPublished,
    });

    setFormOpen(true);
  };

  const saveDomain = async () => {
  try {
    setSaving(true);

    const payload = {
      ...domainForm,
      sortOrder: Number(domainForm.sortOrder) || 0,
    };

    if (formMode === 'create') {
      await ApiService.post(
        '/admin/technology/domains',
        payload
      );

      showSuccess('Technology domain created.');
    } else if (editingId) {
      await ApiService.put(
        `/admin/technology/domains/${editingId}`,
        payload
      );

      showSuccess('Technology domain updated.');
    }

    resetForm();
    await loadAll();
  } catch (err: any) {
    showError(
      err?.message ||
        'Failed to save technology domain.'
    );
  } finally {
    setSaving(false);
  }
};
  const saveTechnology = async () => {
    try {
      setSaving(true);

      const payload = {
        ...technologyForm,
        sortOrder: Number(technologyForm.sortOrder) || 0,
      };

      if (formMode === 'create') {
        await ApiService.post(
          '/admin/technology/technologies',
          payload
        );

        showSuccess('Technology created.');
      } else if (editingId) {
        await ApiService.put(
          `/admin/technology/technologies/${editingId}`,
          payload
        );

        showSuccess('Technology updated.');
      }

      resetForm();
      await loadAll();
    } catch (err: any) {
      showError(
        err?.message ||
          'Failed to save technology.'
      );
    } finally {
      setSaving(false);
    }
  };

  const saveStack = async () => {
    try {
      setSaving(true);

      const payload = {
        ...stackForm,
        sortOrder: Number(stackForm.sortOrder) || 0,
      };

      if (formMode === 'create') {
        await ApiService.post(
          '/admin/technology/stack',
          payload
        );

        showSuccess('Technology stack item created.');
      } else if (editingId) {
        await ApiService.put(
          `/admin/technology/stack/${editingId}`,
          payload
        );

        showSuccess('Technology stack item updated.');
      }

      resetForm();
      await loadAll();
    } catch (err: any) {
      showError(
        err?.message ||
          'Failed to save technology stack item.'
      );
    } finally {
      setSaving(false);
    }
  };

  const saveSection = async () => {
    try {
      setSaving(true);

      const payload = {
        ...sectionForm,
        sortOrder: Number(sectionForm.sortOrder) || 0,
      };

      if (formMode === 'create') {
        await ApiService.post(
          '/admin/technology/sections',
          payload
        );

        showSuccess('Technology section created.');
      } else if (editingId) {
        await ApiService.put(
          `/admin/technology/sections/${editingId}`,
          payload
        );

        showSuccess('Technology section updated.');
      }

      resetForm();
      await loadAll();
    } catch (err: any) {
      showError(
        err?.message ||
          'Failed to save technology section.'
      );
    } finally {
      setSaving(false);
    }
  };

  const handleSave = async () => {
    if (activeTab === 'domains') {
      await saveDomain();
      return;
    }

    if (activeTab === 'technologies') {
      await saveTechnology();
      return;
    }

    if (activeTab === 'stack') {
      await saveStack();
      return;
    }

    await saveSection();
  };

  const deleteItem = async (
    type: Tab,
    id: string
  ) => {
    const confirmed = window.confirm(
      'Are you sure you want to delete this item?'
    );

    if (!confirmed) {
      return;
    }

    try {
      setSaving(true);

      const endpointMap: Record<Tab, string> = {
        domains: `/admin/technology/domains/${id}`,
        technologies: `/admin/technology/technologies/${id}`,
        stack: `/admin/technology/stack/${id}`,
        sections: `/admin/technology/sections/${id}`,
      };

      await ApiService.delete(endpointMap[type]);

      showSuccess('Item deleted successfully.');

      await loadAll();
    } catch (err: any) {
      showError(
        err?.message ||
          'Failed to delete item.'
      );
    } finally {
      setSaving(false);
    }
  };

  const tabItems = [
    {
      id: 'domains' as Tab,
      label: 'Domains',
      icon: Layers,
      count: domains.length,
    },
    {
      id: 'technologies' as Tab,
      label: 'Technologies',
      icon: Cpu,
      count: technologies.length,
    },
    {
      id: 'stack' as Tab,
      label: 'Technology Stack',
      icon: Code2,
      count: stack.length,
    },
    {
      id: 'sections' as Tab,
      label: 'Sections',
      icon: FileText,
      count: sections.length,
    },
  ];

  const inputClass =
    'w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-500 outline-none transition [color-scheme:dark] autofill:[-webkit-text-fill-color:#f1f5f9] autofill:shadow-[inset_0_0_0_1000px_rgb(2,6,23)] focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20';

  const labelClass =
    'mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-400';

  const buttonClass =
    'inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition';

  const handleDomainTechnologyDragEnd = (event: DragEndEvent) => {
    const { active, over } = event;

    if (!over || active.id === over.id) {
      return;
    }

    setDomainForm((current) => {
      const oldIndex = current.technologyIds.indexOf(String(active.id));
      const newIndex = current.technologyIds.indexOf(String(over.id));

      if (oldIndex === -1 || newIndex === -1) {
        return current;
      }

      return {
        ...current,
        technologyIds: arrayMove(
          current.technologyIds,
          oldIndex,
          newIndex
        ),
      };
    });
  };

  const handleSectionTechnologyDragEnd = (event: DragEndEvent) => {
    const { active, over } = event;

    if (!over || active.id === over.id) {
      return;
    }

    setSectionForm((current) => {
      const oldIndex = current.technologyIds.indexOf(String(active.id));
      const newIndex = current.technologyIds.indexOf(String(over.id));

      if (oldIndex === -1 || newIndex === -1) {
        return current;
      }

      return {
        ...current,
        technologyIds: arrayMove(
          current.technologyIds,
          oldIndex,
          newIndex
        ),
      };
    });
  };

  const renderDomainForm = () => (
    <div className="grid gap-5">
      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Name</label>
          <input
            className={inputClass}
            value={domainForm.name}
            onChange={(e) =>
              setDomainForm({
                ...domainForm,
                name: e.target.value,
              })
            }
            placeholder="Software Engineering"
          />
        </div>

        <div>
          <label className={labelClass}>Slug</label>
          <input
            className={inputClass}
            value={domainForm.slug}
            onChange={(e) =>
              setDomainForm({
                ...domainForm,
                slug: e.target.value,
              })
            }
            placeholder="software-engineering"
          />
        </div>
      </div>

      <div>
        <label className={labelClass}>Description</label>
        <textarea
          className={`${inputClass} min-h-28 resize-y`}
          value={domainForm.description}
          onChange={(e) =>
            setDomainForm({
              ...domainForm,
              description: e.target.value,
            })
          }
          placeholder="Describe this technology domain..."
        />
      </div>

      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Icon</label>
          <input
            className={inputClass}
            value={domainForm.icon}
            onChange={(e) =>
              setDomainForm({
                ...domainForm,
                icon: e.target.value,
              })
            }
            placeholder="Code2"
          />
        </div>

        <div>
          <label className={labelClass}>
            Cover Image URL
          </label>
          <input
            className={inputClass}
            value={domainForm.coverImage}
            onChange={(e) =>
              setDomainForm({
                ...domainForm,
                coverImage: e.target.value,
              })
            }
            placeholder="https://..."
          />
        </div>
      </div>

      <div>
  <label className={labelClass}>
    Technologies
  </label>

  <div className="rounded-xl border border-slate-700 bg-slate-950 p-4">

    {domainForm.technologyIds.length > 0 && (
      <div className="mb-4">
        <div className="mb-2 flex items-center justify-between">
          <p className="text-xs font-medium uppercase tracking-wide text-slate-500">
            Selected Order
          </p>

          <span className="text-xs text-slate-500">
            Drag to reorder
          </span>
        </div>

        <DndContext
          collisionDetection={closestCenter}
          onDragEnd={handleDomainTechnologyDragEnd}
        >
          <SortableContext
            items={domainForm.technologyIds}
            strategy={verticalListSortingStrategy}
          >
            <div className="grid gap-2">
              {domainForm.technologyIds.map((id) => {
                const technology = technologies.find(
                  (item) => item.id === id
                );

                if (!technology) {
                  return null;
                }

                return (
                  <SortableTechnologyItem
                    key={technology.id}
                    id={technology.id}
                    name={technology.name}
                    category={technology.category}
                  />
                );
              })}
            </div>
          </SortableContext>
        </DndContext>
      </div>
    )}


    {technologies.length === 0 ? (
      <p className="text-sm text-slate-500">
        No technologies available. Create technologies first.
      </p>
    ) : (
      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {technologies.map((technology) => {
          const selected =
            domainForm.technologyIds.includes(technology.id);

          return (
            <label
              key={technology.id}
              className={`flex cursor-pointer items-start gap-3 rounded-xl border p-3 transition ${
                selected
                  ? 'border-brand-500 bg-brand-500/10'
                  : 'border-slate-800 bg-slate-900/50 hover:border-slate-700'
              }`}
            >
              <input
                type="checkbox"
                checked={selected}
                onChange={() => {
                  setDomainForm((current) => ({
                    ...current,
                    technologyIds: selected
                      ? current.technologyIds.filter(
                          (id) => id !== technology.id
                        )
                      : [
                          ...current.technologyIds,
                          technology.id,
                        ],
                  }));
                }}
                className="mt-1 h-4 w-4 rounded border-slate-600 bg-slate-900 text-brand-600 focus:ring-brand-500"
              />

              <div className="min-w-0">
                <p className="text-sm font-medium text-slate-100">
                  {technology.name}
                </p>

                <p className="mt-1 text-xs text-slate-500">
                  {technology.category}
                </p>
              </div>
            </label>
          );
        })}
      </div>
    )}

    <p className="mt-3 text-xs text-slate-500">
      Select all technologies that belong to this domain.
      A technology can belong to multiple domains.
    </p>
  </div>
</div>

      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Sort Order</label>
          <input
            type="number"
            className={inputClass}
            value={domainForm.sortOrder}
            onChange={(e) =>
              setDomainForm({
                ...domainForm,
                sortOrder: Number(e.target.value),
              })
            }
          />
        </div>

        <ToggleField
          label="Published"
          checked={domainForm.isPublished}
          onChange={(value) =>
            setDomainForm({
              ...domainForm,
              isPublished: value,
            })
          }
        />
      </div>
    </div>
  );

  const renderTechnologyForm = () => (
    <div className="grid gap-5">
      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Name</label>
          <input
            className={inputClass}
            value={technologyForm.name}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                name: e.target.value,
              })
            }
            placeholder="React"
          />
        </div>

        <div>
          <label className={labelClass}>Slug</label>
          <input
            className={inputClass}
            value={technologyForm.slug}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                slug: e.target.value,
              })
            }
            placeholder="react"
          />
        </div>
      </div>

      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Category</label>
          <input
            className={inputClass}
            value={technologyForm.category}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                category: e.target.value,
              })
            }
            placeholder="Framework"
          />
        </div>

        <div>
          <label className={labelClass}>Version</label>
          <input
            className={inputClass}
            value={technologyForm.version}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                version: e.target.value,
              })
            }
            placeholder="19.x"
          />
        </div>
      </div>

      <div>
        <label className={labelClass}>Description</label>
        <textarea
          className={`${inputClass} min-h-28 resize-y`}
          value={technologyForm.description}
          onChange={(e) =>
            setTechnologyForm({
              ...technologyForm,
              description: e.target.value,
            })
          }
          placeholder="Describe the technology..."
        />
      </div>

      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Icon</label>
          <input
            className={inputClass}
            value={technologyForm.icon}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                icon: e.target.value,
              })
            }
            placeholder="React"
          />
        </div>

        <div>
          <label className={labelClass}>
            Website URL
          </label>
          <input
            className={inputClass}
            value={technologyForm.websiteUrl}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                websiteUrl: e.target.value,
              })
            }
            placeholder="https://react.dev"
          />
        </div>
      </div>

      <div>
        <label className={labelClass}>
          Documentation URL
        </label>
        <input
          className={inputClass}
          value={technologyForm.docsUrl}
          onChange={(e) =>
            setTechnologyForm({
              ...technologyForm,
              docsUrl: e.target.value,
            })
          }
          placeholder="https://react.dev/learn"
        />
      </div>

      <div className="grid gap-5 md:grid-cols-3">
        <div>
          <label className={labelClass}>
            Sort Order
          </label>
          <input
            type="number"
            className={inputClass}
            value={technologyForm.sortOrder}
            onChange={(e) =>
              setTechnologyForm({
                ...technologyForm,
                sortOrder: Number(e.target.value),
              })
            }
          />
        </div>

        <ToggleField
          label="Featured"
          checked={technologyForm.featured}
          onChange={(value) =>
            setTechnologyForm({
              ...technologyForm,
              featured: value,
            })
          }
        />

        <ToggleField
          label="Published"
          checked={technologyForm.isPublished}
          onChange={(value) =>
            setTechnologyForm({
              ...technologyForm,
              isPublished: value,
            })
          }
        />
      </div>
    </div>
  );

  const renderStackForm = () => (
    <div className="grid gap-5">
      <div className="grid gap-5 md:grid-cols-2">
        <div>
          <label className={labelClass}>Name</label>
          <input
            className={inputClass}
            value={stackForm.name}
            onChange={(e) =>
              setStackForm({
                ...stackForm,
                name: e.target.value,
              })
            }
            placeholder="PostgreSQL"
          />
        </div>

        <div>
          <label className={labelClass}>Type</label>
          <input
            className={inputClass}
            value={stackForm.type}
            onChange={(e) =>
              setStackForm({
                ...stackForm,
                type: e.target.value,
              })
            }
            placeholder="Database"
          />
        </div>
      </div>

      <div>
        <label className={labelClass}>
          Description
        </label>
        <textarea
