import React, { useEffect, useState } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { fetchApi } from '../lib/api';
import { Zap, ThumbsUp, ArrowLeft, Lightbulb } from 'lucide-react';
import { Button, Badge, Card, CardHeader, CardTitle, CardDescription, CardContent } from '../components/ui';

export const InnovationDetail: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const [concept, setConcept] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchApi<{ concept: any }>(`/innovation/${id}`)
      .then((res) => setConcept(res.concept))
      .catch((err) => console.error(err))
      .finally(() => setLoading(false));
  }, [id]);

  const handleVote = async () => {
    try {
      const res = await fetchApi<{ concept: any }>(`/innovation/${id}/vote`, { method: 'POST' });
      setConcept(res.concept);
    } catch (err) {
      alert('Failed to register vote');
    }
  };

  if (loading) return <div className="p-20 text-center font-mono text-brand-400">Loading Innovation Concept...</div>;
  if (!concept) return <div className="p-20 text-center text-rose-400 font-mono">Concept not found.</div>;

  return (
    <div className="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
      <button onClick={() => navigate('/innovation')} className="flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-white">
        <ArrowLeft className="w-4 h-4" />
        <span>Back to Innovation Hub</span>
      </button>

      <div className="p-8 rounded-3xl glass-panel border border-slate-800 space-y-6">
        <div className="flex items-center justify-between">
          <Badge variant="cyan">{concept.category}</Badge>
          <span className="font-mono text-xs text-cyber-accent font-bold">{concept.conceptStage}</span>
        </div>

        <h1 className="text-3xl sm:text-4xl font-black text-white">{concept.title}</h1>
        <p className="text-slate-300 text-base leading-relaxed">{concept.summary}</p>

        <div className="space-y-2 pt-4">
          <h3 className="text-sm font-mono font-bold text-white uppercase">Full Architecture & Specifications</h3>
          <p className="p-6 bg-slate-950 rounded-2xl border border-slate-800 text-slate-300 font-mono text-xs whitespace-pre-wrap leading-relaxed">
            {concept.fullDetails}
          </p>
        </div>

        <div className="flex items-center justify-between pt-4 border-t border-slate-800 font-mono text-xs text-slate-400">
          <span>Author: {concept.author?.fullName}</span>
          <Button variant="primary" size="sm" onClick={handleVote}>
            <ThumbsUp className="w-4 h-4 mr-1.5" /> Support Concept ({concept.votesCount})
          </Button>
        </div>
      </div>
    </div>
  );
};
