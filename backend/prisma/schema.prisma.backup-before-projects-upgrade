generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                      String                    @unique
  passwordHash               String
  fullName                   String
  role                       String                    @default("STUDENT")
  avatarUrl                  String?
  title                      String?
  isVerified                 Boolean                   @default(false)
  createdAt                  DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime                  @default(now()) @updatedAt @db.Timestamp(6)
  accountStatus              String                    @default("ACTIVE")
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  username                   String?                   @unique
  aiConversations            AIConversation[]          @relation("UserAIConversations")
  authoredArticles           Article[]                 @relation("ArticleAuthor")
  auditLogs                  AuditLog[]                @relation("UserAuditLogs")
  certificates               Certificate[]
  comments                   Comment[]                 @relation("UserComments")
  communityPosts             CommunityPost[]           @relation("UserPosts")
  conversations              ConversationParticipant[]
  authoredCourses            Course[]                  @relation("CourseInstructor")
  enrollments                Enrollment[]
  innovationIdeas            InnovationConcept[]       @relation("ConceptAuthor")
  innovationVotes            InnovationVote[]
  sentMessages               Message[]
  notifications              Notification[]            @relation("UserNotifications")
  orders                     Order[]
  profile                    Profile?
  authoredResearch           ResearchProject[]         @relation("LeadResearcher")
  savedResources             SavedResource[]           @relation("UserSavedResources")

  @@index([email], map: "idx_user_email")
}

model Profile {
  id         String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String  @unique
  company    String?
  location   String?
  website    String?
  github     String?
  linkedin   String?
  twitter    String?
  bio        String?
  skillsJson Json    @default("[]")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Course {
  id           String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  title        String
  slug         String        @unique
  category     String
  description  String
  coverImage   String
  level        String        @default("Beginner")
  duration     String        @default("10 hours")
  isPublished  Boolean       @default(true)
  instructorId String
  createdAt    DateTime      @default(now()) @db.Timestamp(6)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  certificates Certificate[]
  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments  Enrollment[]
  lessons      Lesson[]

  @@index([slug], map: "idx_course_slug")
}

model Lesson {
  id              String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  courseId        String
  title           String
  order           Int
  content         String
  videoUrl        String?
  durationMinutes Int     @default(15)
  isFree          Boolean @default(false)
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Enrollment {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String
  courseId       String
  progress       Int      @default(0)
  completed      Boolean  @default(false)
  enrolledAt     DateTime @default(now()) @db.Timestamp(6)
  lastAccessedAt DateTime @default(now()) @db.Timestamp(6)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, courseId])
}

model Certificate {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String
  courseId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now()) @db.Timestamp(6)
  pdfUrl            String?
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ResearchProject {
  id               String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  title            String
  slug             String        @unique
  area             String
  description      String
  status           String        @default("Ongoing")
  leadResearcherId String
  startYear        Int
  endYear          Int?
  tagsJson         Json          @default("[]")
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  publications     Publication[]
  leadResearcher   User          @relation("LeadResearcher", fields: [leadResearcherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([slug], map: "idx_research_slug")
}

model Publication {
  id                String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  title             String
  abstract          String
  authors           String
  journal           String
  year              Int
  doi               String?
  pdfUrl            String?
  researchProjectId String?
  researchProject   ResearchProject? @relation(fields: [researchProjectId], references: [id], onUpdate: NoAction)
}

model Project {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title         String
  slug          String   @unique
  description   String
  category      String
  status        String   @default("Active")
  techStackJson Json     @default("[]")
  repoUrl       String?
  liveUrl       String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
}

model Product {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  slug        String   @unique
  tagline     String
  description String
  category    String
  version     String   @default("1.0.0")
  status      String   @default("GA")
  demoUrl     String?
  docsUrl     String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  currency    String   @default("USD")
  price       Float    @default(0.0)
  orders      Order[]
}

model InnovationConcept {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title        String
  category     String
  conceptStage String   @default("Idea")
  summary      String
  fullDetails  String
  votesCount   Int      @default(0)
  authorId     String
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  author User             @relation("ConceptAuthor", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votes  InnovationVote[]
}

model InnovationVote {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  conceptId String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamp(6)

  concept InnovationConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conceptId, userId])
  @@index([conceptId])
  @@index([userId])
}

model Article {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  slug        String   @unique
  summary     String
  content     String
  category    String   @default("Announcements")
  coverImage  String
  isPublished Boolean  @default(true)
  authorId    String
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)
  author      User     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([slug], map: "idx_article_slug")
}

model LibraryResource {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title        String
  resourceType String
  author       String
  category     String
  downloadUrl  String?
  description  String
  tagsJson     Json     @default("[]")
  createdAt    DateTime @default(now()) @db.Timestamp(6)
}

model Service {
  id           String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  slug         String  @unique
  icon         String
  shortDesc    String
  fullDesc     String
  featuresJson Json    @default("[]")
  currency     String  @default("USD")
  price        Float   @default(0.0)
  orders       Order[]
}

model Order {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  productId String?
  serviceId String?
  amount    Float
  currency  String   @default("USD")
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  product   Product? @relation(fields: [productId], references: [id], onUpdate: NoAction)
  service   Service? @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model CaseStudy {
  id          String @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  clientName  String
  industry    String
  challenge   String
  solution    String
  resultsJson Json   @default("[]")
  coverImage  String
}

model CommunityPost {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  authorId   String
  title      String
  content    String
  category   String    @default("General")
  likesCount Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  comments   Comment[]
  author     User      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Comment {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String
  authorId  String
  content   String
  createdAt DateTime      @default(now()) @db.Timestamp(6)
  author    User          @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Notification {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  title     String
  message   String
  type      String   @default("system")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_notification_user")
}

model AIConversation {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  title     String      @default("New AI Chat")
  createdAt DateTime    @default(now()) @db.Timestamp(6)
  user      User        @relation("UserAIConversations", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now()) @db.Timestamp(6)
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AuditLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String?
  action      String
  entity      String
  detailsJson Json     @default("{}")
  ipAddress   String   @default("127.0.0.1")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId], map: "idx_audit_user")
}

model SystemMetric {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  metricName  String
  metricValue Float
  timestamp   DateTime @default(now()) @db.Timestamp(6)
}

model SavedResource {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String
  resourceId String
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  user       User     @relation("UserSavedResources", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, resourceId])
}

model Conversation {
  id           String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt    DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @db.Timestamp(6)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Organization {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  tagline     String?
  description String
  vision      String?
  mission     String?
  valuesJson  Json     @default("[]")
  logoUrl     String?
  websiteUrl  String?
  email       String?
  phone       String?
  address     String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  history     OrganizationHistory[]
  milestones  OrganizationMilestone[]
  leaders     OrganizationLeader[]
  departments OrganizationDepartment[]
  units       OrganizationUnit[]
  partners    OrganizationPartner[]
  sections    OrganizationSection[]
}

model OrganizationHistory {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  year           Int
  title          String
  description    String
  sortOrder      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
}

model OrganizationMilestone {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  year           Int
  title          String
  description    String
  icon           String?
  sortOrder      Int          @default(0)
  isPublished    Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
}

model OrganizationLeader {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String
  position       String
  department     String?
  bio            String?
  photoUrl       String?
  email          String?
  websiteUrl     String?
  linkedinUrl    String?
  expertiseJson  Json         @default("[]")
  sortOrder      Int          @default(0)
  isPublished    Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
}

model OrganizationDepartment {
  id                   String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId       String
  name                 String
  slug                 String
  description          String
  purpose              String?
  icon                 String?
  coverImage           String?
  responsibilitiesJson Json         @default("[]")
  sortOrder            Int          @default(0)
  isActive             Boolean      @default(true)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OrganizationUnit {
  id             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  parentId       String?
  name           String
  title          String?
  description    String?
  leaderName     String?
  level          Int                @default(0)
  sortOrder      Int                @default(0)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent         OrganizationUnit?  @relation("OrganizationUnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children       OrganizationUnit[] @relation("OrganizationUnitHierarchy")

  @@index([organizationId])
  @@index([parentId])
}

model OrganizationPartner {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  name           String
  type           String
  description    String?
  logoUrl        String?
  websiteUrl     String?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
}

model OrganizationSection {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  organizationId String
  sectionKey     String
  title          String
  content        String
  imageUrl       String?
  sortOrder      Int          @default(0)
  isPublished    Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, sectionKey])
  @@index([organizationId])
}

model Technology {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  slug        String   @unique
  category    String
  description String
  icon        String?
  websiteUrl  String?
  docsUrl     String?
  version     String?
  featured    Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  domains  TechnologyDomainTechnology[]
  sections TechnologySectionTechnology[]

  @@index([category])
  @@index([isPublished])
}

model TechnologyDomain {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  slug        String   @unique
  description String
  icon        String?
  coverImage  String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  technologies TechnologyDomainTechnology[]

  @@index([isPublished])
}

model TechnologyDomainTechnology {
  id           String @id @default(dbgenerated("(gen_random_uuid())::text"))
  domainId     String
  technologyId String
  sortOrder    Int    @default(0)

  domain     TechnologyDomain @relation(fields: [domainId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technology Technology       @relation(fields: [technologyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([domainId, technologyId])
  @@index([domainId])
  @@index([technologyId])
}

model TechnologyStack {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  type        String
  description String?
  icon        String?
  websiteUrl  String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@index([type])
  @@index([isPublished])
}

model TechnologySection {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sectionKey  String
  title       String
  content     String
  imageUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  technologies TechnologySectionTechnology[]

  @@unique([sectionKey])
  @@index([isPublished])
}

model TechnologySectionTechnology {
  id           String @id @default(dbgenerated("(gen_random_uuid())::text"))
  sectionId    String
  technologyId String
  sortOrder    Int    @default(0)

  section    TechnologySection @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technology Technology        @relation(fields: [technologyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sectionId, technologyId])
  @@index([sectionId])
  @@index([technologyId])
}

model AIKnowledgeDocument {
  id          String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  source      String
  sourceId    String
  title       String
  content     String
  embedding   Unsupported("vector(384)")?
  contentHash String?
  createdAt   DateTime                    @default(now()) @db.Timestamp(6)
  updatedAt   DateTime                    @default(now()) @updatedAt @db.Timestamp(6)

  @@index([source, sourceId])
  @@index([contentHash])
}
