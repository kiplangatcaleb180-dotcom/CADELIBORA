export const createTechnologySection = async (
  req: Request,
  res: Response,
  next: NextFunction
) => {
  try {
    const {
      sectionKey,
      title,
      content,
      imageUrl,
      technologyIds,
      sortOrder,
      isPublished,
    } = req.body;

    if (!sectionKey?.trim()) {
      return res.status(400).json({
        success: false,
        message: 'Technology section key is required.',
      });
    }

    if (!title?.trim()) {
      return res.status(400).json({
        success: false,
        message: 'Technology section title is required.',
      });
    }

    if (!content?.trim()) {
      return res.status(400).json({
        success: false,
        message: 'Technology section content is required.',
      });
    }

    if (
      technologyIds !== undefined &&
      !Array.isArray(technologyIds)
    ) {
      return res.status(400).json({
        success: false,
        message: 'technologyIds must be an array.',
      });
    }

    const existingSection =
      await prisma.technologySection.findUnique({
        where: {
          sectionKey: sectionKey.trim(),
        },
      });

    if (existingSection) {
      return res.status(409).json({
        success: false,
        message:
          'A technology section with this key already exists.',
      });
    }

    const ids: string[] = Array.isArray(technologyIds)
      ? [...new Set(
          technologyIds.filter(
            (id): id is string =>
              typeof id === 'string' && id.length > 0
          )
        )]
      : [];

    if (ids.length > 0) {
      const technologies =
        await prisma.technology.findMany({
          where: {
            id: {
              in: ids,
            },
          },
          select: {
            id: true,
          },
        });

      if (technologies.length !== ids.length) {
        return res.status(400).json({
          success: false,
          message:
            'One or more selected technologies do not exist.',
        });
      }
    }

    const section =
      await prisma.$transaction(async (tx) => {
        const createdSection =
          await tx.technologySection.create({
            data: {
              sectionKey: sectionKey.trim(),
              title: title.trim(),
              content: content.trim(),
              imageUrl:
                imageUrl?.trim() || null,
              sortOrder:
                Number.isInteger(Number(sortOrder))
                  ? Number(sortOrder)
                  : 0,
              isPublished:
                typeof isPublished === 'boolean'
                  ? isPublished
                  : true,
            },
          });

        if (ids.length > 0) {
          await tx.technologySectionTechnology.createMany({
            data: ids.map(
              (technologyId: string, index: number) => ({
                sectionId: createdSection.id,
                technologyId,
                sortOrder: index,
              })
            ),
          });
        }

        return tx.technologySection.findUnique({
          where: {
            id: createdSection.id,
          },
          include: {
            technologies: {
              include: {
                technology: true,
              },
              orderBy: {
                sortOrder: 'asc',
              },
            },
          },
        });
      });

    res.status(201).json({
      success: true,
      section,
    });
  } catch (error) {
    next(error);
  }
};

