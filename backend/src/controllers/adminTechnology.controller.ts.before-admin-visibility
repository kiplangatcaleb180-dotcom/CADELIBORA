export const createTechnologyDomain = async (
  req: Request,
  res: Response,
  next: NextFunction
) => {
  try {
    const {
      name,
      slug,
      description,
      icon,
      coverImage,
      technologyIds,
      sortOrder,
      isPublished,
    } = req.body;

    if (!name?.trim()) {
      return res.status(400).json({
        success: false,
        message: 'Technology domain name is required.',
      });
    }

    if (!slug?.trim()) {
      return res.status(400).json({
        success: false,
        message: 'Technology domain slug is required.',
      });
    }

    if (!description?.trim()) {
      return res.status(400).json({
        success: false,
        message:
          'Technology domain description is required.',
      });
    }

    if (
      technologyIds !== undefined &&
      !Array.isArray(technologyIds)
    ) {
      return res.status(400).json({
        success: false,
        message: 'technologyIds must be an array.',
      });
    }

    const existingDomain =
      await prisma.technologyDomain.findUnique({
        where: {
          slug: slug.trim(),
        },
      });

    if (existingDomain) {
      return res.status(409).json({
        success: false,
        message:
          'A technology domain with this slug already exists.',
      });
    }

    const uniqueTechnologyIds: string[] = [
      ...new Set<string>(
        (technologyIds ?? [])
          .filter(
            (id: unknown): id is string =>
              typeof id === 'string' &&
              id.trim().length > 0
          )
          .map((id: string) => id.trim())
      ),
    ];

    if (uniqueTechnologyIds.length > 0) {
      const technologies =
        await prisma.technology.findMany({
          where: {
            id: {
              in: uniqueTechnologyIds,
            },
          },
          select: {
            id: true,
          },
        });

      if (
        technologies.length !==
        uniqueTechnologyIds.length
      ) {
        return res.status(400).json({
          success: false,
          message:
            'One or more selected technologies do not exist.',
        });
      }
    }

    const domain =
      await prisma.technologyDomain.create({
        data: {
          name: name.trim(),
          slug: slug.trim(),
          description: description.trim(),
          icon: icon?.trim() || null,
          coverImage: coverImage?.trim() || null,

          sortOrder:
            Number.isInteger(Number(sortOrder))
              ? Number(sortOrder)
              : 0,

          isPublished:
            typeof isPublished === 'boolean'
              ? isPublished
              : true,

          technologies: {
            create: uniqueTechnologyIds.map(
              (technologyId: string, index: number) => ({
                sortOrder: index,

                technology: {
                  connect: {
                    id: technologyId,
                  },
                },
              })
            ),
          },
        },

        include: {
          technologies: {
            include: {
              technology: true,
            },
            orderBy: {
              sortOrder: 'asc',
            },
          },
        },
      });

    res.status(201).json({
      success: true,
      domain,
    });
  } catch (error) {
    next(error);
  }
};

export const updateTechnologyDomain = async (
  req: Request,
  res: Response,
  next: NextFunction
) => {
  try {
    const { domainId } = req.params;

    const existingDomain =
      await prisma.technologyDomain.findUnique({
        where: {
          id: domainId,
        },
      });

    if (!existingDomain) {
      return res.status(404).json({
        success: false,
        message: 'Technology domain not found.',
      });
    }

    const {
      name,
      slug,
      description,
      icon,
      coverImage,
      technologyIds,
      sortOrder,
      isPublished,
    } = req.body;

    if (name !== undefined && !name?.trim()) {
      return res.status(400).json({
        success: false,
        message:
          'Technology domain name cannot be empty.',
      });
    }

    if (slug !== undefined && !slug?.trim()) {
      return res.status(400).json({
        success: false,
        message:
          'Technology domain slug cannot be empty.',
      });
    }

    if (
      description !== undefined &&
      !description?.trim()
    ) {
      return res.status(400).json({
        success: false,
        message:
          'Technology domain description cannot be empty.',
      });
    }

    if (
      technologyIds !== undefined &&
      !Array.isArray(technologyIds)
    ) {
      return res.status(400).json({
        success: false,
        message: 'technologyIds must be an array.',
      });
    }

    if (
      slug !== undefined &&
      slug.trim() !== existingDomain.slug
    ) {
      const slugExists =
        await prisma.technologyDomain.findUnique({
          where: {
            slug: slug.trim(),
          },
        });

      if (slugExists) {
        return res.status(409).json({
          success: false,
          message:
            'A technology domain with this slug already exists.',
        });
      }
    }

    const uniqueTechnologyIds:
      | string[]
      | undefined =
      technologyIds === undefined
        ? undefined
        : [
            ...new Set<string>(
              technologyIds
                .filter(
                  (id: unknown): id is string =>
                    typeof id === 'string' &&
                    id.trim().length > 0
                )
                .map((id: string) => id.trim())
            ),
          ];

    if (
      uniqueTechnologyIds !== undefined &&
      uniqueTechnologyIds.length > 0
    ) {
      const technologies =
        await prisma.technology.findMany({
          where: {
            id: {
              in: uniqueTechnologyIds,
            },
          },
          select: {
            id: true,
          },
        });

      if (
        technologies.length !==
        uniqueTechnologyIds.length
      ) {
        return res.status(400).json({
          success: false,
          message:
            'One or more selected technologies do not exist.',
        });
      }
    }

    const domain =
      await prisma.$transaction(async (tx) => {
        if (uniqueTechnologyIds !== undefined) {
          await tx.technologyDomainTechnology.deleteMany({
            where: {
              domainId,
            },
          });
        }

        return tx.technologyDomain.update({
          where: {
            id: domainId,
          },

          data: {
            ...(name !== undefined && {
              name: name.trim(),
            }),

            ...(slug !== undefined && {
              slug: slug.trim(),
            }),

            ...(description !== undefined && {
              description: description.trim(),
            }),

            ...(icon !== undefined && {
              icon: icon?.trim() || null,
            }),

            ...(coverImage !== undefined && {
              coverImage:
                coverImage?.trim() || null,
            }),

            ...(sortOrder !== undefined && {
              sortOrder: Number(sortOrder) || 0,
            }),

            ...(isPublished !== undefined && {
              isPublished: Boolean(isPublished),
            }),

            ...(uniqueTechnologyIds !== undefined && {
              technologies: {
                create: uniqueTechnologyIds.map(
                  (
                    technologyId: string,
                    index: number
                  ) => ({
                    sortOrder: index,

                    technology: {
                      connect: {
                        id: technologyId,
                      },
                    },
                  })
                ),
              },
            }),
          },

          include: {
            technologies: {
              include: {
                technology: true,
              },
              orderBy: {
                sortOrder: 'asc',
              },
            },
          },
        });
      });

    res.json({
      success: true,
      domain,
    });
  } catch (error) {
    next(error);
  }
};

