      technologyIds !== undefined &&
      !Array.isArray(technologyIds)
    ) {
      return res.status(400).json({
        success: false,
        message: 'technologyIds must be an array.',
      });
    }

    if (
      sectionKey !== undefined &&
      sectionKey.trim() !== existingSection.sectionKey
    ) {
      const keyExists =
        await prisma.technologySection.findUnique({
          where: {
            sectionKey: sectionKey.trim(),
          },
        });

      if (keyExists) {
        return res.status(409).json({
          success: false,
          message:
            'A technology section with this key already exists.',
        });
      }
    }

    const ids: string[] | null =
      technologyIds !== undefined
        ? [
            ...new Set(
              (technologyIds as unknown[]).filter(
                (id: unknown): id is string =>
                  typeof id === 'string' && id.length > 0
              )
            ),
          ]
        : null;

    if (ids && ids.length > 0) {
      const technologies =
        await prisma.technology.findMany({
          where: {
            id: {
              in: ids,
            },
          },
          select: {
            id: true,
          },
        });

      if (technologies.length !== ids.length) {
        return res.status(400).json({
          success: false,
          message:
            'One or more selected technologies do not exist.',
        });
      }
    }

    const section =
      await prisma.$transaction(async (tx) => {
        await tx.technologySection.update({
          where: {
            id: sectionId,
          },
          data: {
            ...(sectionKey !== undefined && {
              sectionKey: sectionKey.trim(),
            }),
            ...(title !== undefined && {
              title: title.trim(),
            }),
            ...(content !== undefined && {
              content: content.trim(),
            }),
            ...(imageUrl !== undefined && {
              imageUrl:
                imageUrl?.trim() || null,
            }),
            ...(sortOrder !== undefined && {
              sortOrder: Number(sortOrder) || 0,
            }),
            ...(isPublished !== undefined && {
              isPublished: Boolean(isPublished),
            }),
          },
        });

        if (ids !== null) {
          await tx.technologySectionTechnology.deleteMany({
            where: {
              sectionId,
            },
          });

          if (ids.length > 0) {
            await tx.technologySectionTechnology.createMany({
              data: ids.map(
                (
                  technologyId: string,
                  index: number
                ) => ({
                  sectionId,
                  technologyId,
                  sortOrder: index,
                })
              ),
            });
          }
        }

        return tx.technologySection.findUnique({
          where: {
            id: sectionId,
          },
          include: {
            technologies: {
              include: {
                technology: true,
              },
              orderBy: {
                sortOrder: 'asc',
              },
            },
          },
        });
      });

    res.json({
      success: true,
      section,
    });
  } catch (error) {
    next(error);
  }
};

export const deleteTechnologySection = async (
  req: Request,
  res: Response,
  next: NextFunction
) => {
  try {
    const { sectionId } = req.params;

    const existingSection =
      await prisma.technologySection.findUnique({
        where: {
          id: sectionId,
        },
      });

    if (!existingSection) {
      return res.status(404).json({
        success: false,
        message:
          'Technology section not found.',
      });
    }

    await prisma.technologySection.delete({
      where: {
        id: sectionId,
      },
    });

    res.json({
      success: true,
      message:
        'Technology section deleted successfully.',
    });
  } catch (error) {
    next(error);
  }
};