{
  "name": "cadelibora-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CADELIBORA Core Backend API Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:integration": "tsx src/testIntegration.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-admins": "node --import tsx/esm prisma/seedAdminAccounts.ts",
    "db:studio": "prisma studio",
    "ai:index": "tsx src/scripts/indexAIKnowledge.ts"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@huggingface/transformers": "^4.3.0",
    "@mistralai/mistralai": "^2.7.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "resend": "^6.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
